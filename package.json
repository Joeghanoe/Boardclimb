{
  "name": "boardclimb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra/*"
  ],
  "engines": {
    "bun": ">=1.4.5-canary.1"
  },
  "scripts": {
    "typecheck": "bun check",
    "lint": "bun lint",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "test": "bun test",
    "test:fast": "bun test --path-ignore-patterns '**/*.scale.test.ts'",
    "verify": "bun scripts/verify.ts",
    "verify:fast": "bun scripts/verify.ts --fast",
    "web": "bun run --cwd apps/mobile web"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.5-canary.1"
}
