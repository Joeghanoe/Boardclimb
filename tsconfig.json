{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["bun"],
    "paths": {
      "@boardclimb/catalog-core/testing": ["./packages/catalog-core/src/testing/index.ts"],
      "@boardclimb/bluetooth-core/testing": ["./packages/bluetooth-core/src/testing/index.ts"],
      "@boardclimb/application/testing": ["./packages/application/src/testing/index.ts"],
      "@boardclimb/storage-local/testing": ["./packages/storage-local/src/testing/index.ts"],
      "@boardclimb/provider-snapshots/manifest": ["./packages/provider-snapshots/src/manifest.ts"],
      "@boardclimb/*": ["./packages/*/src/index.ts"]
    }
  },
  "include": [
    "./packages/**/*.ts",
    "infra/**/*.ts",
    "tests/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "**/dist"]
}
